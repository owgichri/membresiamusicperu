{
  "cleanUrls": true,
  "headers": [
    { "source": "/tracks.json", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/previews/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] },
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] }
  ]
}
